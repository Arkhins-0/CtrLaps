# Copy to .env and fill in. .env is gitignored.

# --- Server ------------------------------------------------------------------
# The site's own address, no trailing slash. On Vercel it may be left out: the
# project's production domain is used.
NEXT_PUBLIC_SITE_URL=""

# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET=""

# Email (Brevo transactional). Blank key = no email is sent.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="CTR[L]APS"

# Push (Firebase Cloud Messaging, server side): the Firebase service-account
# JSON, base64-encoded (`base64 -w0 service-account.json`). Same value on Vercel.
FIREBASE_SERVICE_ACCOUNT=""

# Push in the browser (Firebase web app). All five or none; not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# --- App build ---------------------------------------------------------------
# Only the keys below are compiled into the Android app (see app/build.gradle.kts).
# The server the app talks to (required to build), e.g. https://example.com.
CTRLAPS_BASE_URL=""
CTRLAPS_UPDATE_URL=""
# GitHub owner/name whose Releases carry the APKs. On Vercel the deployed repo is used when blank.
CTRLAPS_GITHUB_REPO=""

# Release signing (all four required for a signed release build; otherwise it is unsigned).
# The path is relative to android/.
# CTRLAPS_KEYSTORE_PATH="ctrlaps-release.jks"
# CTRLAPS_KEYSTORE_PASSWORD=""
# CTRLAPS_KEY_ALIAS=""
# CTRLAPS_KEY_PASSWORD=""

# Names shown in mails and, at build time, in the app (About → License / Notice). Blank ones are left out.
# Who made it: "Powered by <name>", linking to <domain>.
POWERED_BY_NAME=""
POWERED_BY_DOMAIN=""
# The organisation's main domain, on the right of every mail's header.
MAIN_DOMAIN=""

# Vercel's daily jobs (vercel.json crons) send it as "Bearer <CRON_SECRET>": erasing deleted accounts after their 7 days.
# Any long random value; blank turns the jobs off.
CRON_SECRET=""
