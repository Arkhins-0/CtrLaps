<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice at once when the phone loses its connection (the no-connection icon). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the app can install its own update, downloaded from a release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Popups for messages and race changes. Asked on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Documents are saved to Downloads/CTRLAPS. Only older Android needs a permission for that. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The QR scanner on the account page. Asked when it is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The attach sheet's recent photos (WhatsApp-style gallery). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Only if the person turns it on (Files page → "Show all files on this phone"): Recents lists every file,
         as WhatsApp's does. Nothing else needs it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Voice notes and sharing where you are, from the message box. Asked on first launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- So the phone does not put the app to sleep and hold back its popups. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Race-session and event reminders right on time (Settings → Permissions → Exact reminders). Never asked for:
         without it they are set inexact and may come a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reminders set again after the phone restarts (alarms don't survive it). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Which apps can open a downloaded document. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Phone makers' autostart and battery pages (ui/Battery.kt): Android 11+ hides them unless named here. -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.letv.android.letvsafe" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.transsion.phonemaster" />
    </queries>

    <application
        android:name=".CtrlapsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ctrlaps.Starting">
        <!-- Saved passwords are shared with the website (Google Password Manager reads both sides' asset links). -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ctrlaps.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A tapped push notification (the server's click_action), with
                 the in-app link to open in its "link" extra. -->
            <intent-filter>
                <action android:name="OPEN_LINK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Links into the app open here when it is installed (verified
                 against the site's /.well-known/assetlinks.json): invites,
                 password resets, verification codes, and every signed-in page.
                 The sign-in page itself and /download stay in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/reset/" />
                <data android:pathPrefix="/register/" />
                <data android:pathPrefix="/v/" />
                <data android:path="/home" />
                <data android:pathPrefix="/home?" />
                <data android:path="/schedule" />
                <data android:pathPrefix="/w/" />
                <data android:pathPrefix="/c/" />
                <data android:path="/standings" />
                <data android:pathPrefix="/results/" />
                <data android:path="/chats" />
                <data android:pathPrefix="/chats/" />
                <data android:path="/people" />
                <data android:pathPrefix="/people/" />
                <data android:path="/account" />
                <data android:path="/archive" />
                <data android:pathPrefix="/archive/" />
                <data android:path="/support" />
                <data android:pathPrefix="/support/" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.CtrlapsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="other" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gold" />

        <!-- Where the package installer reports how the in-app update went. -->
        <receiver
            android:name=".data.UpdateInstallReceiver"
            android:exported="false" />

        <!-- A chat notification's Reply and Mark read buttons. -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- An event's reminder, set on the phone (EventReminders). -->
        <receiver
            android:name=".data.EventReminderReceiver"
            android:exported="false" />

        <!-- A race session's reminder, set on the phone (SessionReminders). -->
        <receiver
            android:name=".reminders.SessionReminderReceiver"
            android:exported="false" />

        <!-- Every reminder set again after a restart of the phone, an update, or once exact alarms are allowed. -->
        <receiver
            android:name=".reminders.RemindersBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (widgets/), drawn from the phone's copy; and the Next session countdown's alarm. -->
        <receiver
            android:name=".widgets.NextSessionWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_session_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_session_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.UnreadWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_unread_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.StandingsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_standings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/standings_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetTickReceiver"
            android:exported="false" />

        <!-- After the app has updated itself, a notification brings it back. -->
        <receiver
            android:name=".data.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lends the downloaded update APK to the system installer when the
             package installer cannot be used, and downloaded documents to
             the app that opens them on older Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
