<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen icon below Android 12 (androidx core-splashscreen), which shows it in a 288dp
    view masked to a centred 192dp circle. The badge is a fixed 164dp, placed so the smallest
    circle around its visible pixels sits in the centre, 2dp inside the mask. Android 12+ uses
    drawable-v31/splash_icon.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="164.2dp"
        android:height="161.9dp"
        android:left="62.1dp"
        android:top="76.4dp"
        android:right="61.7dp"
        android:bottom="49.7dp">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/ctr_logo" />
    </item>
</layer-list>
