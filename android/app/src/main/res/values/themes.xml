<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ctrlaps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Every dialog's window (Compose dialogs take it from here): blurs what is behind on Android 12+ (values-v31). -->
        <item name="android:dialogTheme">@style/Theme.Ctrlaps.Dialog</item>
    </style>

    <style name="Theme.Ctrlaps.Dialog" parent="android:ThemeOverlay.Material.Dialog" />

    <!-- The championship badge on night while the app starts. -->
    <style name="Theme.Ctrlaps.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ctrlaps</item>
    </style>
</resources>
