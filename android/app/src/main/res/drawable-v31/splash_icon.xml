<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen icon on Android 12+. A single-frame animation on purpose: the system draws an
    animatable icon live, at full size, while a still one is first drawn into a launcher-icon-sized
    bitmap and scaled up, which blurs the badge.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="true">
    <item
        android:drawable="@drawable/splash_icon_logo"
        android:duration="1000" />
</animation-list>
